{
	"name": "@techsquidtv/eslint-plugin-structured-logging",
	"version": "0.0.0",
	"description": "ESLint plugin with library-agnostic lint rules for structured logging in TypeScript.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KyleTryon/eslint-plugin-structured-logging.git"
	},
	"license": "MIT",
	"type": "module",
	"main": "lib/index.js",
	"types": "lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"files": [
		"docs/",
		"lib/",
		"LICENSE.md",
		"README.md"
	],
	"scripts": {
		"build": "vp pack",
		"check": "vp check && vp run knip && vp run docs:rules:check && vp run tsc && vp test",
		"docs:rules": "vp pack && eslint-doc-generator",
		"docs:rules:check": "vp pack && eslint-doc-generator --check true",
		"format": "vp fmt .",
		"format:check": "vp fmt . --check",
		"format:write": "vp fmt .",
		"knip": "knip",
		"lint": "vp lint . --max-warnings 0",
		"prepare": "vp config",
		"release": "node scripts/release.mjs",
		"release:dry-run": "node scripts/release.mjs --dry-run",
		"test": "vp test",
		"tsc": "tsc"
	},
	"dependencies": {
		"@typescript-eslint/utils": "^8.63.0"
	},
	"devDependencies": {
		"@typescript-eslint/parser": "^8.63.0",
		"@typescript-eslint/rule-tester": "^8.63.0",
		"@types/node": "26.1.1",
		"@vitest/coverage-v8": "catalog:",
		"console-fail-test": "0.6.1",
		"eslint": "10.6.0",
		"eslint-doc-generator": "^3.6.0",
		"eslint-plugin-eslint-plugin": "^7.4.1",
		"knip": "^6.25.0",
		"typescript": "6.0.3",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": ">=9.0.0",
		"typescript": ">=5.0.0"
	},
	"publishConfig": {
		"provenance": true
	},
	"packageManager": "pnpm@10.4.0",
	"engines": {
		"node": ">=20.19.0"
	},
	"pnpm": {
		"overrides": {
			"vite": "npm:@voidzero-dev/vite-plus-core@0.2.2"
		},
		"peerDependencyRules": {
			"allowAny": [
				"vite"
			],
			"allowedVersions": {
				"vite": "*"
			}
		}
	}
}
